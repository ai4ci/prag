{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "./src/**/*.ts",
    "./test/**/*.ts",
    "../core/src/**/*.ts",
    "../core/test/**/*.ts",
    "../cli/src/**/*.ts",
    "../cli/test/**/*.ts"
  ]
}