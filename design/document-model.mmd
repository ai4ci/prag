classDiagram
    %% Feature lifecycle: draft = still being specified; accepted = approved scope,
    %% implementation not started; in_progress = implementation begun but scope
    %% remains; completed = scoped requirements are implemented and tested.
    class FeatureStatus {
        <<enumeration>>
        draft
        accepted
        in_progress
        completed
    }

    %% Triage priority for features, tasks, and issues
    class Priority {
        <<enumeration>>
        low
        medium
        high
    }

    %% Execution state for engineering work items
    class TaskStatus {
        <<enumeration>>
        todo
        in_progress
        done
        blocked
    }

    %% Problem/bug report state
    class IssueStatus {
        <<enumeration>>
        open
        in_progress
        resolved
        closed
    }

    %% Decision record state
    class AdrStatus {
        <<enumeration>>
        proposed
        accepted
        superseded
    }

    %% feature: Functional or architectural capability of prag (spec, requirements, and interfaces)
    class feature {
        +string title
        +FeatureStatus status
        +Priority priority
        +string area
    }

    %% task: Actionable engineering task representing concrete work to be implemented
    class task {
        +string title
        +TaskStatus status
        +Priority priority
    }

    %% issue: Defects, bugs, unexpected behaviors, or runtime regressions discovered in the system
    class issue {
        +string title
        +IssueStatus status
        +Priority priority
    }

    %% adr: Architectural Decision Record capturing context, options evaluated, and binding design decisions
    class adr {
        +string title
        +AdrStatus status
        +date decided
    }

    feature "0..*" --> "0..*" adr : guided-by
    feature "0..*" --> "0..*" src : implemented-by
    task "0..*" --> "0..1" feature : relates-to
    task "0..*" --> "0..*" task : blocks
    task "0..*" --> "0..*" src : addressed-by
    issue "0..*" --> "0..1" feature : relates-to
    issue "0..*" --> "0..*" task : blocks
    adr "0..*" --> "0..*" adr : supersedes

    %% test: abstract source family for test files (per-package subclasses below)
    class test {
        <<abstract>>
    }
    class coretest
    class daemontest
    class clitest

    %% Every task must name at least one test function that covers it.
    %% Direction is task -> test so the edge lives in task frontmatter:
    %% loom's reverse-link comments canonicalise a test anchor back to the
    %% `src` scheme, which rejects a test-family relation.
    task "0..*" --> "1..*" test : tested-by

    src <|-- test
    test <|-- coretest
    test <|-- daemontest
    test <|-- clitest

